{
    "name": "discograph",
    "description": "Social Graphing for the Discogs Database",
    "private": true,
    "version": "2.1.0",
    "type": "module",
    "author": [
        {
            "name": "Josiah Wolf Oberholtzer",
            "url": "http://josiahwolfoberholtzer.com"
        },
        {
            "name": "Andy Radburn",
            "url": "http://andyradburn.co.uk"
        }
    ],
    "homepage": "http://discograph.org",
    "license": "MIT",
    "readme": "../README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/aradburn/discograph.git"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "dev": "vite",
        "dev-debug": "vite --debug",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "lint": "eslint source --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint source --ext ts,tsx --fix",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "check-updates": "npx npm-check-updates"
    },
    "dependencies": {
        "bootstrap": "^5.3.5",
        "bootstrap-icons": "^1.11.3",
        "corejs-typeahead": "^1.3.4",
        "d3": "^7.9.0",
        "file-saver": "^2.0.5",
        "jquery": "^3.7.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.51.1",
        "@rollup/plugin-inject": "^5.0.5",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/bootstrap": "^5.2.10",
        "@types/d3": "^7.4.3",
        "@types/file-saver": "^2.0.7",
        "@types/jquery": "^3.5.32",
        "@types/node": "^22.14.1",
        "@typescript-eslint/eslint-plugin": "^8.29.1",
        "@typescript-eslint/parser": "^8.29.1",
        "@vitest/coverage-v8": "^3.1.1",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-prettier": "^5.2.6",
        "eslint-plugin-testing-library": "^7.1.1",
        "jsdom": "^26.0.0",
        "prettier": "^3.5.3",
        "sass": "^1.86.3",
        "typescript": "^5.8.3",
        "vite": "^6.2.6",
        "vitest": "^3.1.1"
    }
}
